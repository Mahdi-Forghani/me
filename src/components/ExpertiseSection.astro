---
import SectionHeading from './SectionHeading.astro';

const groups = [
  {
    title: 'Backend Engineering',
    description: 'Designing and building reliable, well-structured backend services.',
    skills: ['C#', '.NET', 'ASP.NET Core', 'REST APIs', 'Entity Framework Core'],
    icon: 'M4 17V7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Zm4-6h8m-8 4h5'
  },
  {
    title: 'Data & Infrastructure',
    description: 'Running and scaling the systems that keep production stable.',
    skills: ['SQL Server', 'PostgreSQL', 'Redis', 'Docker', 'Kubernetes', 'CI/CD'],
    icon: 'M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3Zm0 0v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3'
  },
  {
    title: 'Distributed Systems',
    description: 'Handling scale, concurrency, and failure with predictable outcomes.',
    skills: ['Hangfire', 'Background jobs', 'Idempotency', 'Reliability', 'Concurrency'],
    icon: 'M6 4h4v4H6zm8 0h4v4h-4zM6 16h4v4H6zm8 0h4v4h-4zM8 8v4h8V8M8 16v-4'
  },
  {
    title: 'Technical Leadership',
    description: 'Turning ambiguous problems into clear, executable engineering work.',
    skills: ['Architecture', 'Estimation', 'Code review', 'Mentoring', 'Process design'],
    icon: 'M12 4a3 3 0 1 1 0 6 3 3 0 0 1 0-6ZM5 20a7 7 0 0 1 14 0'
  }
];
---

<section class="section" aria-labelledby="expertise">
  <div class="container">
    <SectionHeading
      id="expertise"
      index="02"
      title="Expertise"
      subtitle="Practical strengths built through production systems"
    />
    <div class="expertise-groups">
      {groups.map((group) => (
        <article class="expertise-group">
          <div class="expertise-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d={group.icon} />
            </svg>
          </div>
          <h3>{group.title}</h3>
          <p>{group.description}</p>
          <div class="chip-list">
            {group.skills.map((skill) => <span class="chip">{skill}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
