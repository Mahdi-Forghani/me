---
import SectionHeading from './SectionHeading.astro';
---

<section class="section" aria-labelledby="about">
  <div class="container about-grid">
    <div class="about-copy">
      <SectionHeading
        id="about"
        index="01"
        title="About"
        subtitle="From web development to backend engineering and technical leadership"
      />
      <p>
        I started in web development around 2017, then expanded into backend engineering, system design, and engineering
        leadership. Today I focus on building dependable backend services, making technical decisions, and helping teams
        ship quality software with better planning and engineering practices.
      </p>
      <p>
        I care about designing for reliability from the start — thinking through failure modes, concurrency, and
        observability — while staying close to the product and business context behind every decision.
      </p>
    </div>
    <div class="stat-list" aria-label="Highlights">
      <div class="stat-item">
        <p class="stat-number">8+</p>
        <p class="stat-label">Years of experience</p>
      </div>
      <div class="stat-item">
        <p class="stat-number">2</p>
        <p class="stat-label">Companies, one journey</p>
      </div>
      <div class="stat-item">
        <p class="stat-number">10+</p>
        <p class="stat-label">Production systems shipped</p>
      </div>
      <div class="stat-item">
        <p class="stat-number">1</p>
        <p class="stat-label">Technical Lead role, present</p>
      </div>
    </div>
  </div>
</section>
