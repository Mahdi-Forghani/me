---
import SectionHeading from './SectionHeading.astro';
---

<section class="section" aria-labelledby="interests">
  <div class="container">
    <SectionHeading id="interests" index="04" title="Interests" subtitle="What keeps me curious outside the day-to-day" />
    <div class="bento-gallery">
      <article class="gallery-tile gallery-tile--wide">
        <h3>Software Architecture</h3>
        <p>Designing systems that remain maintainable as products and teams grow.</p>
      </article>
      <article class="gallery-tile">
        <h3>Product Thinking</h3>
        <p>Bridging technical decisions with customer and business outcomes.</p>
      </article>
      <article class="gallery-tile gallery-tile--tall">
        <h3>Continuous Learning</h3>
        <p>Exploring patterns, trade-offs, and better ways to build reliable software.</p>
      </article>
      <article class="gallery-tile">
        <h3>Engineering Culture</h3>
        <p>Mentoring, feedback, and practical process improvements that scale with teams.</p>
      </article>
      <article class="gallery-tile gallery-tile--wide">
        <h3>Open Source & Tooling</h3>
        <p>Improving developer experience with better internal tools and automation.</p>
      </article>
    </div>
  </div>
</section>
