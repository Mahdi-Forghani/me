---
import SectionHeading from './SectionHeading.astro';
---

<section class="section" id="interests" aria-labelledby="interests-heading">
  <div class="container">
    <SectionHeading id="interests-heading" index="04" title="Interests" subtitle="What keeps me curious and grounded" />
    <div class="interests-layout">
      <article class="interest-card interest-card--featured">
        <div class="interest-card-top"><span class="interest-mark mono">01</span><span class="interest-type">Read</span></div>
        <h3>Reading</h3>
        <p>Books, ideas, and new perspectives.</p>
      </article>
      <article class="interest-card">
        <div class="interest-card-top"><span class="interest-mark mono">02</span><span class="interest-type">Move</span></div>
        <h3>Swimming</h3>
        <p>A clear mind and steady rhythm.</p>
      </article>
      <article class="interest-card">
        <div class="interest-card-top"><span class="interest-mark mono">03</span><span class="interest-type">Explore</span></div>
        <h3>Travel</h3>
        <p>New places, fresh perspectives.</p>
      </article>
      <article class="interest-card">
        <div class="interest-card-top"><span class="interest-mark mono">04</span><span class="interest-type">Guide</span></div>
        <h3>Mentoring</h3>
        <p>Helping people grow through feedback.</p>
      </article>
      <article class="interest-card">
        <div class="interest-card-top"><span class="interest-mark mono">05</span><span class="interest-type">Think</span></div>
        <h3>Product thinking</h3>
        <p>Requirements, constraints, and trade-offs.</p>
      </article>
      <article class="interest-card">
        <div class="interest-card-top"><span class="interest-mark mono">06</span><span class="interest-type">Grow</span></div>
        <h3>Learning</h3>
        <p>Docs, prototypes, and hands-on practice.</p>
      </article>
      <article class="interest-card">
        <div class="interest-card-top"><span class="interest-mark mono">07</span><span class="interest-type">Design</span></div>
        <h3>Interface design</h3>
        <p>Clear interfaces. Better experiences.</p>
      </article>
      <article class="interest-card">
        <div class="interest-card-top"><span class="interest-mark mono">08</span><span class="interest-type">Build</span></div>
        <h3>Open source &amp; automation</h3>
        <p>Less friction through useful tools.</p>
      </article>
    </div>
  </div>
</section>
