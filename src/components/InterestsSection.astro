---
import SectionHeading from './SectionHeading.astro';
---

<section class="section" id="interests" aria-labelledby="interests-heading">
  <div class="container">
    <SectionHeading id="interests-heading" index="04" title="Interests" subtitle="Topics I follow beyond day-to-day development" />
    <div class="bento-gallery">
      <article class="gallery-tile gallery-tile--wide">
        <h3>Developer Tooling</h3>
        <p>Improving local development, testing, CI/CD, and developer tools.</p>
      </article>
      <article class="gallery-tile">
        <h3>Product Development</h3>
        <p>Understanding requirements, constraints, and trade-offs throughout software development.</p>
      </article>
      <article class="gallery-tile gallery-tile--tall">
        <h3>Technical Learning</h3>
        <p>Learning technologies through documentation, prototypes, and hands-on projects.</p>
      </article>
      <article class="gallery-tile">
        <h3>Interface Design</h3>
        <p>Paying attention to clear interfaces and the details that make software easier to use.</p>
      </article>
      <article class="gallery-tile gallery-tile--wide">
        <h3>Open Source &amp; Automation</h3>
        <p>Building small tools and automations to reduce repetitive work.</p>
      </article>
    </div>
  </div>
</section>
