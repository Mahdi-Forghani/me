---
import SectionHeading from './SectionHeading.astro';
---

<section class="section" id="interests" aria-labelledby="interests-heading">
  <div class="container">
    <SectionHeading id="interests-heading" index="04" title="Interests" subtitle="What keeps me curious and grounded" />
    <div class="interests-layout">
      <article class="interest-feature">
        <div class="interest-label mono"><span>01</span> Professional curiosity</div>
        <div>
          <h3>Tools that make work better</h3>
          <p>Developer tooling, open source, and automation for less friction.</p>
        </div>
        <div class="interest-tags" aria-label="Tooling interests">
          <span>Tooling</span>
          <span>Open source</span>
          <span>Automation</span>
        </div>
      </article>

      <div class="interest-cards">
        <article class="interest-card">
          <div class="interest-card-top"><span class="interest-mark mono">02</span><span class="interest-type">Work</span></div>
          <h3>Product thinking</h3>
          <p>Requirements, constraints, and trade-offs.</p>
        </article>
        <article class="interest-card">
          <div class="interest-card-top"><span class="interest-mark mono">03</span><span class="interest-type">Growth</span></div>
          <h3>Learning</h3>
          <p>Docs, prototypes, and hands-on practice.</p>
        </article>
        <article class="interest-card">
          <div class="interest-card-top"><span class="interest-mark mono">04</span><span class="interest-type">Design</span></div>
          <h3>Interface design</h3>
          <p>Clear interfaces. Better experiences.</p>
        </article>
        <article class="interest-card">
          <div class="interest-card-top"><span class="interest-mark mono">05</span><span class="interest-type">People</span></div>
          <h3>Mentoring</h3>
          <p>Helping people grow through feedback.</p>
        </article>
      </div>

      <div class="interests-personal">
        <div class="interest-personal-heading">
          <span class="interest-label mono"><span>06</span> Outside work</span>
          <p>Simple things that keep life balanced.</p>
        </div>
        <article class="interest-card interest-card--personal">
          <div class="interest-card-top"><span class="interest-mark mono">A</span><span class="interest-type">Reset</span></div>
          <h3>Reading</h3>
          <p>Books, ideas, and new perspectives.</p>
        </article>
        <article class="interest-card interest-card--personal">
          <div class="interest-card-top"><span class="interest-mark mono">B</span><span class="interest-type">Energy</span></div>
          <h3>Swimming</h3>
          <p>A clear mind and steady rhythm.</p>
        </article>
        <article class="interest-card interest-card--personal">
          <div class="interest-card-top"><span class="interest-mark mono">C</span><span class="interest-type">Explore</span></div>
          <h3>Travel</h3>
          <p>New places, fresh perspectives.</p>
        </article>
      </div>
    </div>
  </div>
</section>
