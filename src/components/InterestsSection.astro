---
import SectionHeading from './SectionHeading.astro';
---

<section class="section" aria-labelledby="interests">
  <div class="container">
    <SectionHeading id="interests" index="04" title="Interests" subtitle="Questions and practices that keep me curious" />
    <div class="bento-gallery">
      <article class="gallery-tile gallery-tile--wide">
        <h3>Developer Experience</h3>
        <p>Finding small ways to make local development, testing, and delivery less friction-heavy.</p>
      </article>
      <article class="gallery-tile">
        <h3>Product Mechanics</h3>
        <p>Understanding how constraints shape useful products and better decisions.</p>
      </article>
      <article class="gallery-tile gallery-tile--tall">
        <h3>Deliberate Learning</h3>
        <p>Following new ideas through experiments, notes, and hands-on practice rather than collecting buzzwords.</p>
      </article>
      <article class="gallery-tile">
        <h3>Clear Interfaces</h3>
        <p>Paying attention to typography, interaction, and the details that make digital work feel understandable.</p>
      </article>
      <article class="gallery-tile gallery-tile--wide">
        <h3>Open Source & Tooling</h3>
        <p>Building small tools and automations that remove repeated work and give teams more room to think.</p>
      </article>
    </div>
  </div>
</section>
