---
import SectionHeading from './SectionHeading.astro';

const steps = [
  {
    title: 'Make complexity visible',
    description: 'I break ambiguous requirements into clear engineering work so teams can execute with confidence.'
  },
  {
    title: 'Design for reliability',
    description: 'I think through failure modes, retries, concurrency, and idempotency early in system design.'
  },
  {
    title: 'Raise the quality bar',
    description: 'I use code review, standards, and mentoring to improve technical quality over time.'
  },
  {
    title: 'Stay close to product needs',
    description: 'I collaborate across product and customer feedback loops to deliver practical outcomes.'
  }
];
---

<section class="section" aria-labelledby="how-i-work">
  <div class="container">
    <SectionHeading id="how-i-work" index="03" title="How I Work" subtitle="The work is technical. The impact is collaborative." />
    <div class="stepper">
      {steps.map((step, i) => (
        <article class="step">
          <div class="step-index">{String(i + 1).padStart(2, '0')}</div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
