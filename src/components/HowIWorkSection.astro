---
import SectionHeading from './SectionHeading.astro';

const steps = [
  {
    title: 'Clarify the outcome',
    description: 'Start with the user or business outcome, constraints, and what success needs to look like.'
  },
  {
    title: 'Choose the useful path',
    description: 'Make trade-offs visible, then align on the smallest path that creates meaningful progress.'
  },
  {
    title: 'Ship in slices',
    description: 'Keep feedback close by breaking work into focused increments that can be understood and reviewed.'
  },
  {
    title: 'Learn from the result',
    description: 'Use what happened in production and collaboration to improve the next decision.'
  }
];
---

<section class="section" aria-labelledby="how-i-work">
  <div class="container">
    <SectionHeading id="how-i-work" index="03" title="How I Work" subtitle="A simple loop for making progress on complex work" />
    <div class="stepper">
      {steps.map((step, i) => (
        <article class="step">
          <div class="step-index">{String(i + 1).padStart(2, '0')}</div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
