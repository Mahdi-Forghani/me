---
import SectionHeading from './SectionHeading.astro';

const steps = [
  {
    title: 'Define the Problem',
    description: 'Clarify requirements, constraints, and acceptance criteria.'
  },
  {
    title: 'Evaluate Trade-offs',
    description: 'Compare options and choose an approach that fits the product and technical constraints.'
  },
  {
    title: 'Deliver Incrementally',
    description: 'Break work into small, testable changes and get feedback early.'
  },
  {
    title: 'Monitor and Improve',
    description: 'Review the result in production and improve the system based on evidence.'
  }
];
---

<section class="section" aria-labelledby="how-i-work">
  <div class="container">
    <SectionHeading id="how-i-work" index="03" title="How I Work" subtitle="My approach to software delivery" />
    <div class="stepper">
      {steps.map((step, i) => (
        <article class="step">
          <div class="step-index">{String(i + 1).padStart(2, '0')}</div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
