---
import SectionHeading from './SectionHeading.astro';

const roles = [
  {
    period: '2026 - Present',
    title: 'Technical Lead — MrBilit',
    highlights: [
      'Technical direction, architecture, and engineering decisions',
      'Estimation, planning, and breaking down work',
      'Code reviews, mentoring, and improving engineering quality'
    ],
    tech: ['.NET', 'Architecture', 'Leadership']
  },
  {
    period: '2019 - 2026',
    title: 'Software Engineer / Fullstack Web Developer — Kasra Company (Innovation Department)',
    highlights: [
      'Built and evolved production web and backend systems',
      'Grew toward backend architecture and product-oriented engineering',
      'Worked with real customer feedback and iterative delivery'
    ],
    tech: ['C#', 'ASP.NET Core', 'SQL Server']
  }
];
---

<section class="section" aria-labelledby="experience">
  <div class="container">
    <SectionHeading id="experience" index="05" title="Experience" subtitle="Professional progression" />
    <div class="timeline-rail">
      {roles.map((role) => (
        <div class="timeline-entry">
          <span class="timeline-dot"></span>
          <div class="timeline-card">
            <p class="timeline-year mono">{role.period}</p>
            <h3>{role.title}</h3>
            <ul>
              {role.highlights.map((item) => <li>{item}</li>)}
            </ul>
            <div class="tech-tags">
              {role.tech.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
