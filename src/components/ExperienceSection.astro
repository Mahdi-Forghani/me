---
import SectionHeading from './SectionHeading.astro';

const roles = [
  {
    period: '2026 - Present',
    title: 'Technical Lead',
    company: 'MrBilit',
    current: true,
    highlights: [
      'Technical direction, system design, and engineering decisions',
      'Technical planning, estimation, and task breakdown',
      'Code reviews, mentoring, and improving development standards'
    ],
    tech: ['.NET', 'System Design', 'Technical Leadership']
  },
  {
    period: '2019 - 2026',
    title: 'Software Engineer / Full-Stack Web Developer',
    company: 'Kasra Company',
    current: false,
    highlights: [
      'Built and maintained production web applications and backend services.',
      'Focused on backend development, system design, and software delivery.',
      'Used customer feedback to improve features through iterative delivery.'
    ],
    tech: ['C#', 'ASP.NET Core', 'SQL Server']
  }
];
---

<section class="section" id="experience" aria-labelledby="experience-heading">
  <div class="container">
    <SectionHeading id="experience-heading" index="05" title="Experience" subtitle="Career history" />
    <ol class="timeline-rail" aria-label="Professional experience">
      {roles.map((role) => (
        <li class:list={['timeline-entry', { 'timeline-entry--current': role.current }]}>
          <span class="timeline-dot" aria-hidden="true"></span>
          <article class="timeline-card">
            <div class="timeline-card-header">
              <div>
                <p class="timeline-year mono">{role.period}</p>
                <h3>{role.title}</h3>
                <p class="timeline-company">{role.company}</p>
              </div>
              {role.current && <span class="timeline-status">Current role</span>}
            </div>
            <ul class="timeline-highlights">
              {role.highlights.map((item) => <li>{item}</li>)}
            </ul>
            <div class="tech-tags" aria-label={`${role.title} technologies`}>
              {role.tech.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>
