---
import SectionHeading from './SectionHeading.astro';

const roles = [
  {
    period: '2026 - Present',
    title: 'Technical Lead — MrBilit',
    highlights: [
      'Technical direction, system design, and engineering decisions',
      'Technical planning, estimation, and task breakdown',
      'Code reviews, mentoring, and improving development standards'
    ],
    tech: ['.NET', 'System Design', 'Technical Leadership']
  },
  {
    period: '2019 - 2026',
    title: 'Software Engineer / Full-Stack Web Developer — Kasra Company',
    highlights: [
      'Built and maintained production web applications and backend services.',
      'Focused on backend development, system design, and software delivery.',
      'Used customer feedback to improve features through iterative delivery.'
    ],
    tech: ['C#', 'ASP.NET Core', 'SQL Server']
  }
];
---

<section class="section" id="experience" aria-labelledby="experience-heading">
  <div class="container">
    <SectionHeading id="experience-heading" index="05" title="Experience" subtitle="Career history" />
    <div class="timeline-rail">
      {roles.map((role) => (
        <div class="timeline-entry">
          <span class="timeline-dot"></span>
          <div class="timeline-card">
            <p class="timeline-year mono">{role.period}</p>
            <h3>{role.title}</h3>
            <ul>
              {role.highlights.map((item) => <li>{item}</li>)}
            </ul>
            <div class="tech-tags">
              {role.tech.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
