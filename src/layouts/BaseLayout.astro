---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mahdi Forghani | Technical Lead & Software Engineer',
  description = 'Technical Lead and Software Engineer specializing in .NET, backend engineering, system design, and technical leadership.'
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#02091F" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://mahdi-forghani.github.io/me/" />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
